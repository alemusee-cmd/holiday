#  גרסת Node.js רצויה (נשתמש ב-LTS יציבה)
FROM node:18-alpine

# יצירת תיקיית עבודה בתוך הקונטיינר
WORKDIR /app

# העתקת קבצי התלויות
COPY package*.json ./

# התקנת החבילות
RUN npm install

# העתקת שאר קוד הקอนטיינר
COPY . .

# חשיפת הפורט שהאפליקציה רצה עליו (שווה לבדוק בקוד באיזה פורט היא משתמשת, לרוב 3000)
EXPOSE 3000

# פקודת ההפעלה של האפליקציה
CMD ["npm", "start"]